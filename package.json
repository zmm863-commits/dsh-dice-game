{
  "name": "dsh-dice-game",
  "version": "0.1.3",
  "description": "🎲 骰子大作战 (Dice Battle) — classic dice games from Jincheng, Shanxi, China (中国山西晋城传统骰子玩法): Liar's Dice (吹牛), Red-point guessing, Red/Blue, Big/Small, Odd/Even and Straight. Single-player vs AI plus PeerJS WebRTC online play, fully bilingual zh/en. Adds a sidebar entry that opens the full game in the center column.",
  "type": "module",
  "license": "MIT",
  "author": "zmm863-commits",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmm863-commits/dsh-dice-game.git"
  },
  "homepage": "https://github.com/zmm863-commits/dsh-dice-game",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "PUBLISH.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dice",
    "game",
    "liars-dice",
    "骰子",
    "吹牛"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "jsdom": "^30.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown && node build.mjs && node scripts/copy-assets.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs && node scripts/smoke-cordis.mjs && node scripts/smoke-p0.mjs"
  }
}